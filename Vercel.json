{
    "version": 1,
    "builds": [
        {
            "src": "KELASS/script.js",
            "use": "@vercel/node",
            "config": {
                "BuildsCommand": "npm install"
            }
        }
    ],
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "KELASS/script.js"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}